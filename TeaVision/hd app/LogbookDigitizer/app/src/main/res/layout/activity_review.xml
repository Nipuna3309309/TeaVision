<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Image"
            android:textColor="#757575"
            android:textSize="12sp" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginHorizontal="8dp"
            android:background="#4CAF50" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="#4CAF50" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Confirm Data"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:background="#E0E0E0">

        <ImageView
            android:id="@+id/ivReviewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="4dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#4CAF50" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <TableLayout
                    android:id="@+id/tableLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">

                    <TableRow android:background="#E0E0E0">
                        <TextView android:text="No." style="@style/TableHeader"/>
                        <TextView android:text="Month" style="@style/TableHeader"/>
                        <TextView android:text="Yield\nTodate" style="@style/TableHeader"/>
                        <TextView android:text="Fertilizer\nApp." style="@style/TableHeader"/>
                        <TextView android:text="Elements" style="@style/TableHeader"/>
                        <TextView android:text="Weeding" style="@style/TableHeader"/>
                        <TextView android:text="Annual" style="@style/TableHeader"/>
                        <TextView android:text="N\nK" style="@style/TableHeader"/>
                        <TextView android:text="Todate" style="@style/TableHeader"/>
                        <TextView android:text="Hi.\nZnc" style="@style/TableHeader"/>
                        <TextView android:text="DOLOVITE" style="@style/TableHeader"/>
                        <TextView android:text="Remarks" style="@style/TableHeader"/>
                    </TableRow>

                </TableLayout>
            </ScrollView>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Confirm &amp; Save to Records"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_margin="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>
</LinearLayout>